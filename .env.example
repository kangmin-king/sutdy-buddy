VITE_SUPABASE_URL=
# 값은 대시보드 Settings → API Keys의 **Publishable key**(`sb_publishable_...`)다.
# legacy anon JWT(`eyJ...`)를 쓰면 안 된다 — 2026-09-09에 새 체계로 옮겼고, legacy 키는
# 노출된 service_role을 무효화하면서 함께 비활성화된다. 변수 이름이 ANON_KEY로 남아 있는 건
# 값 교체와 이름 변경을 분리했기 때문이다(본체 .env 주석 참고).
VITE_SUPABASE_ANON_KEY=
VITE_AMPLITUDE_API_KEY=
